#!/bin/bash

{{ ansible_managed | comment }}

echo "Stopping Kodi..."
pkill -TERM kodi.bin

for i in {1..10}; do
  if ! pgrep -x kodi.bin >/dev/null; then
    break
  fi
  sleep 1
done

if pgrep -x kodi.bin >/dev/null; then
  echo "Kodi didn't stop cleanly; killing it..."
  pkill -KILL kodi.bin
  sleep 1
fi

echo "Starting Kodi..."
DISPLAY=:0 kodi --windowing=wayland -fs --audio-backend=alsa >/dev/null 2>&1 &

echo "Kodi restarted."
